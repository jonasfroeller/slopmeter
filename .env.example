# Slopmeter Environment Configuration Template
# Copy this file to .env and fill in any provider settings needed for your environment.

# Trae SQLCipher AES-256 Key (64-character hex string; optional, falls back to Trae's universal default key if omitted)
TRAE_SQLCIPHER_KEY=

# Trae database path (optional, auto-detected from local install directories if omitted)
# TRAE_DATABASE_PATH=

# Trae config directory (optional, auto-detected if omitted)
# TRAE_CONFIG_DIR=

# Warp database path (optional, auto-detected if omitted)
# WARP_DATABASE_PATH=

# Continue configuration directory (optional, defaults to ~/.continue)
# CONTINUE_CONFIG_DIR=

# Cline VS Code User data directory (optional, auto-detected if omitted)
# CLINE_CONFIG_DIR=

# Roo Code/PearAI VS Code User data directory (optional, auto-detected if omitted)
# ROO_CONFIG_DIR=

# Kilo Code VS Code User data directory (optional, auto-detected if omitted)
# KILO_CONFIG_DIR=

# Ollama log directory (optional, auto-detected if omitted)
# OLLAMA_LOG_DIR=

# Native FX state directory (optional; Windows also scans every registered WSL2 distro automatically)
# FX_HOME=

# Cursor state database path (optional, auto-detected if omitted)
# CURSOR_STATE_DB_PATH=

# Freebuff config/data root (optional, auto-detected from ~/.config/manicode* if omitted)
# FREEBUFF_CONFIG_DIR=
# FREEBUFF_DATA_DIR=
# Freebuff Desktop API URL (optional; auto-detected from the Desktop orchestrator log)
# FREEBUFF_API_URL=

# Grok directory (optional, auto-detected from ~/.grok or $GROK_HOME if omitted)
# GROK_HOME=

# Windsurf configuration directory (optional, auto-detected if omitted)
# WINDSURF_CONFIG_DIR=

# Windsurf Codeium data directory containing the cascade directory (optional)
# WINDSURF_CODEIUM_DIR=

# Windsurf language-server binary path (optional, auto-detected if omitted)
# WINDSURF_LANGUAGE_SERVER_PATH=

# Windsurf log path (optional, auto-detected if omitted)
# WINDSURF_LOG_PATH=

# Optional overrides for a running Windsurf language server
# WINDSURF_LS_PID=
# WINDSURF_LS_HTTP_PORT=
# WINDSURF_LS_CSRF_TOKEN=

# Windsurf scan limits (optional)
# WINDSURF_MAX_TRAJECTORIES=1000
# WINDSURF_MAX_STEP_PAGES=100
